# Customer accounts — see prisma/schema.prisma. Required for signup/login to work at all.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Email verification codes. Without this, lib/notifications/registry.ts
# falls back to logging codes to the server console instead of sending
# real email — safe for local development, not for production.
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS="Coffee Bar <onboarding@resend.dev>"

# SMS verification codes. Without all three, phone signup also falls back
# to the console. Confirm Twilio's Solomon Islands (+677) coverage/pricing
# before relying on this in production.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Existing — unrelated to accounts, listed here only because this is the
# project's one env file.
STAFF_PASSCODE="honiara-staff"
